    "%@ PADS" : {
      "comment" : "A menu item that lets the user select the grid size of their kit. The label is generated by calling `.label` on the `GridSize` enum case.",
      "isCommentAutoGenerated" : true
    },
    "%@/%@ pads · %@" : {
      "comment" : "A description of a game kit, including the number of pads it has been filled out of, and the date it was last updated.",
