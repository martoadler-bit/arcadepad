    "Uploads your kit's samples so anyone with the link can try the pads in a browser — no app install needed. Effects aren't previewed on the web, just playback. Links expire after 7 days.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploads your kit's samples so anyone with the link can try the pads in a browser — no app install needed. Effects aren't previewed on the web, just playback. Links expire after 7 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube los samples de tu kit para que cualquiera con el link pueda probar los pads desde el navegador — sin instalar la app. Los efectos no se escuchan en la web, solo la reproducción simple. Los links vencen a los 7 días."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia as samples do seu kit para que qualquer pessoa com o link possa testar os pads no navegador — sem precisar instalar o app. Os efeitos não são reproduzidos na web, só a reprodução simples. Os links expiram em 7 dias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie les samples de ton kit pour que n'importe qui avec le lien puisse essayer les pads dans un navigateur — sans installer l'app. Les effets ne sont pas prévisualisés sur le web, seulement la lecture simple. Les liens expirent après 7 jours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt die Samples deines Kits hoch, damit jeder mit dem Link die Pads im Browser ausprobieren kann — ohne App-Installation. Effekte werden im Web nicht wiedergegeben, nur die reine Wiedergabe. Links laufen nach 7 Tagen ab."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carica i sample del tuo kit così chiunque abbia il link può provare i pad dal browser — senza installare l'app. Gli effetti non vengono riprodotti sul web, solo la riproduzione semplice. I link scadono dopo 7 giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キットのサンプルをアップロードし、リンクを持つ誰でもアプリをインストールせずにブラウザでパッドを試せるようにします。エフェクトはWebではプレビューされず、再生のみです。リンクは7日で失効します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传你套件中的音频样本，这样任何拿到链接的人都能在浏览器里试玩这些垫片——无需安装App。网页端不支持效果预览，只能播放原声。链接7天后失效。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키트의 샘플을 업로드하여 링크를 가진 누구나 앱 설치 없이 브라우저에서 패드를 사용해 볼 수 있게 합니다. 이펙트는 웹에서 미리 들을 수 없고 재생만 가능합니다. 링크는 7일 후 만료됩니다."
          }
        }
      }
    },
    "Only share samples you have the rights to.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only share samples you have the rights to."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartí solo samples sobre los que tengas derechos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhe apenas samples sobre os quais você tenha direitos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne partagez que des samples dont vous détenez les droits."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile nur Samples, an denen du die Rechte besitzt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi solo sample di cui possiedi i diritti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "権利を持つサンプルのみ共有してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只分享你拥有权利的音频样本。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권리가 있는 샘플만 공유하세요."
          }
        }
      }
    },
