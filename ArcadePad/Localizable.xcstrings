    "Anyone with the link can play these samples in a browser for 7 days. Only share content you have the rights to." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder mit dem Link kann diese Samples 7 Tage lang im Browser abspielen. Teile nur Inhalte, an denen du die Rechte besitzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone with the link can play these samples in a browser for 7 days. Only share content you have the rights to."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquiera con el link va a poder reproducir estos samples desde un navegador durante 7 días. Compartí solo contenido sobre el que tengas derechos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute personne disposant du lien pourra lire ces samples dans un navigateur pendant 7 jours. Ne partagez que du contenu dont vous détenez les droits."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiunque abbia il link potrà riprodurre questi sample in un browser per 7 giorni. Condividi solo contenuti di cui possiedi i diritti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リンクを持つ人は誰でも7日間ブラウザでこれらのサンプルを再生できます。権利を持つコンテンツのみ共有してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "링크가 있는 누구나 7일 동안 브라우저에서 이 샘플을 재생할 수 있습니다. 권리가 있는 콘텐츠만 공유하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualquer pessoa com o link poderá reproduzir essas samples em um navegador por 7 dias. Compartilhe apenas conteúdo sobre o qual você tenha direitos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何拿到链接的人都能在7天内于浏览器中播放这些样本。请只分享你拥有权利的内容。"
          }
        }
      }
    },
    "ASSIGN TO PAD %@" : {
      "comment" : "A button that assigns a sample to a specific pad. The argument is the pad number.",
