    "Hold the joystick in a direction, then pick its FX here — each of the 4 directions keeps its own.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the joystick in a direction, then pick its FX here — each of the 4 directions keeps its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantené el joystick en una dirección y elegí su FX acá — cada una de las 4 direcciones guarda el suyo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure o joystick em uma direção e escolha o FX aqui — cada uma das 4 direções guarda o seu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez le joystick dans une direction, puis choisissez son FX ici — chacune des 4 directions garde le sien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte den Joystick in eine Richtung und wähle hier den FX dafür — jede der 4 Richtungen behält ihren eigenen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni il joystick in una direzione, poi scegli il suo FX qui — ognuna delle 4 direzioni mantiene il proprio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジョイスティックを一方向に押したまま、ここでそのFXを選択してください。4方向それぞれが独自のFXを保持します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将摇杆保持在某个方向，然后在此选择对应的音效——4个方向各自保留自己的设置。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조이스틱을 한 방향으로 누른 채로 여기서 FX를 선택하세요 — 4방향 각각 고유한 설정을 유지합니다."
          }
        }
      }
    },
    "Hold a direction to edit or trigger its FX.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold a direction to edit or trigger its FX."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantené una dirección para editar o disparar su FX."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure uma direção para editar ou disparar seu FX."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez une direction pour modifier ou déclencher son FX."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte eine Richtung, um deren FX zu bearbeiten oder auszulösen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuta una direzione per modificare o attivare il suo FX."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "方向を押したままにすると、そのFXを編集または実行できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住某个方向即可编辑或触发对应音效。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방향을 누르고 있으면 해당 FX를 편집하거나 실행합니다."
          }
        }
      }
    },
