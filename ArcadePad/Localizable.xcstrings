    "Cuts placed at the loudest onsets — hits, words, notes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuts placed at the loudest onsets — hits, words, notes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cortes se ubican en los ataques más fuertes — golpes, palabras, notas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os cortes ficam nos ataques mais fortes — batidas, palavras, notas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les coupes sont placées sur les attaques les plus fortes — coups, mots, notes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnitte werden an den lautesten Einsätzen gesetzt — Schläge, Wörter, Noten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tagli vengono posizionati sugli attacchi più forti — colpi, parole, note."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も強いアタック（ヒット、単語、音）にカットが配置されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切点会自动放在最强的起始点——打点、词语或音符处。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 강한 시작점(타격, 단어, 음)에 컷이 배치됩니다."
          }
        }
      }
    },
